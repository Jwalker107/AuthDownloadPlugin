{
  "plugin_name": "AuthDownloadPlugin",
  "log": "./tests/logfile.log",
  "log_level": 20,
  "url_configs": [
    {
      "config_name": "default",
      "url_list": [
        ".*"
      ],
      "Header": {
        "Authorization": "token testing"
      }
    },
    {
      "config_name": "github",
      "url_list": [
        "https://.*\\.github\\.com/.*",
        "https://.*\\.githubusercontent\\.com/.*"
      ],
      "Header": {
        "Authorization": "token testing"
      }
    }
  ]
}
